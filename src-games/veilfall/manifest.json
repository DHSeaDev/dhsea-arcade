{
  "manifest_version": 3,
  "name": "VEILFALL",
  "version": "0.8.0",
  "description": "Solo social deduction in your side panel: nine souls, one hidden traitor, eight opponents who each know only their own calling.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "optional_host_permissions": [
    "https://api.groq.com/*"
  ],
  "action": {
    "default_title": "Open VEILFALL"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
