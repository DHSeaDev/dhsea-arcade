{
  "manifest_version": 3,
  "name": "Underglory",
  "version": "2.3.0",
  "description": "A hundred hand-drawn mazes. Grow a morning glory to the arch. Offline, no account, no tracking.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Underglory",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "offline_enabled": true
}
