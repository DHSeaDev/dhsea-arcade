{
  "manifest_version": 3,
  "name": "Lumenreel - Prism Crash",
  "version": "0.9.0",
  "description": "A prism slot machine where time is the only currency. Spin for Facets, collect 125 critters across two skins. No money, ever.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Lumenreel - Prism Crash"
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "ui/app.html"
  }
}