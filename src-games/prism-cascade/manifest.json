{
  "manifest_version": 3,
  "name": "Prism Cascade \u2014 Physics Arcade",
  "short_name": "PrismCascade",
  "version": "2.0.0",
  "description": "Charge, shatter, splash — float point-bubbles to the beam. 100 levels, 6 challenge runs, 83 achievements, generative music.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}